{
  "expo": {
    "name": "Doalize",
    "slug": "doalize",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logomodoclaro.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F5F5"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doalize.app"
    },

    "android": {
      "package": "com.doalize.app",

      "adaptiveIcon": {
        "foregroundImage": "./assets/logomodoclaro.png",
        "backgroundColor": "#F5F5F5"
      },

      "edgeToEdgeEnabled": true
    },

    "web": {
      "favicon": "./assets/logo.png"
    },

    "extra": {
      "eas": {
        "projectId": "fdc0a7a9-72d9-457f-8203-fcd7479966c3"
      }
    }
  }
}